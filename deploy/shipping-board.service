[Unit]
Description=Shipping board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aryan
WorkingDirectory=/srv/shipping-board
Environment=GH_TOKEN_FILE=/srv/shipping-board/.gh-token
ExecStart=/usr/bin/env npx vp preview --port 5181 --strictPort
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
